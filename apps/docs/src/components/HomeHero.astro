---
import { ArrowRight, Copy, Terminal } from "lucide-astro"

const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const links = [
  { href: `${base}/getting-started/installation/`, label: "Install" },
  { href: `${base}/measurements/package-size/`, label: "Package sizes" },
  { href: `${base}/measurements/validation-benchmarks/`, label: "Benchmarks" },
  { href: `${base}/modules/validation/#playground`, label: "Try validation" },
  { href: `${base}/modules/`, label: "All modules" },
] as const

const examples = [
  {
    label: "Validation",
    href: `${base}/modules/validation/`,
    source: `const User = object({
  email: string().email(),
})`,
  },
  {
    label: "Money",
    href: `${base}/modules/money/arithmetic/`,
    source: `allocateMoney(1000, [1, 1, 1])
// [334, 333, 333]`,
  },
  {
    label: "Async",
    href: `${base}/modules/async/`,
    source: `await retry(fetchData, {
  attempts: 3,
  signal,
})`,
  },
] as const
---

<section class="kern-home not-content" aria-labelledby="_top">
  <div class="kern-home-intro">
    <h1 id="_top" data-page-title>Kern</h1>
    <p class="kern-home-tagline">
      Small, dependency-free TypeScript primitives for everyday application code.
    </p>
    <p class="kern-home-modules">Validation · Money · Dates · Async · Data</p>
    <p class="kern-support-line">Zero runtime dependencies · Tree-shakeable · Standard Schema</p>

    <nav class="kern-primary-links" aria-label="Kern documentation">
      {links.map((link, index) => (
        <a class:list={{ "kern-primary-link": index === 0 }} href={link.href}>
          {link.label}
          {index === 0 && <ArrowRight aria-hidden="true" size={15} />}
        </a>
      ))}
    </nav>

    <fieldset class="kern-install-command" aria-label="Install Kern with Bun">
      <div>
        <Terminal aria-hidden="true" size={14} />
        <code>bun add @sousaivan/kern</code>
      </div>
      <button type="button" data-copy-install aria-label="Copy installation command">
        <Copy aria-hidden="true" size={14} />
        <span data-copy-label aria-hidden="true">Copy</span>
        <span class="sr-only" data-copy-status role="status" aria-live="polite"></span>
      </button>
    </fieldset>
  </div>

  <section class="kern-home-examples" aria-label="Three Kern examples">
    {examples.map((example) => (
      <article class="kern-home-example">
        <header>
          <h2>{example.label}</h2>
          <a href={example.href} aria-label={`Read the ${example.label} guide`}>
            Guide <ArrowRight aria-hidden="true" size={13} />
          </a>
        </header>
        <pre><code>{example.source}</code></pre>
      </article>
    ))}
  </section>
</section>

<script>
document.querySelectorAll<HTMLButtonElement>("[data-copy-install]").forEach((button) => {
  button.addEventListener("click", async () => {
    const label = button.querySelector<HTMLElement>("[data-copy-label]")
    const status = button.querySelector<HTMLElement>("[data-copy-status]")
    if (!label || !status) return

    try {
      await navigator.clipboard.writeText("bun add @sousaivan/kern")
      label.textContent = "Copied"
      status.textContent = "Installation command copied."
    } catch {
      label.textContent = "Copy failed"
      status.textContent = "The installation command could not be copied."
    }

    window.setTimeout(() => {
      label.textContent = "Copy"
      status.textContent = ""
    }, 1_600)
  })
})
</script>

<style>
.kern-home {
  padding: clamp(4rem, 8vw, 7.5rem) 0 clamp(3rem, 7vw, 6rem);
}

.kern-home-intro {
  max-width: 57rem;
}

h1 {
  margin: 0;
  color: var(--kern-color-text-strong);
  font-size: clamp(3.5rem, 8vw, 7rem);
  font-weight: 690;
  letter-spacing: -0.065em;
  line-height: 0.95;
}

.kern-home-tagline {
  max-width: 42rem;
  margin: 1.5rem 0 0;
  color: var(--kern-color-text-body);
  font-size: clamp(1.15rem, 2vw, 1.45rem);
  line-height: 1.55;
  text-wrap: balance;
}

.kern-home-modules,
.kern-support-line {
  margin: 0;
  font-family: var(--__sl-font-mono);
  font-size: 0.78rem;
  line-height: 1.7;
}

.kern-home-modules {
  margin-top: 1.45rem;
  color: var(--kern-color-text-strong);
}

.kern-support-line {
  margin-top: 0.3rem;
  color: var(--kern-color-text-muted);
}

.kern-primary-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem 1rem;
  margin-top: 1.65rem;
}

.kern-primary-links a {
  color: var(--kern-color-text-body);
  font-size: 0.875rem;
  font-weight: 620;
  text-decoration: none;
}

.kern-primary-links a:not(.kern-primary-link):hover {
  color: var(--kern-color-text-strong);
  text-decoration: underline;
  text-underline-offset: 0.2em;
}

.kern-primary-links .kern-primary-link {
  display: inline-flex;
  min-height: 2.45rem;
  align-items: center;
  gap: 0.4rem;
  border-radius: 0.35rem;
  background: var(--sl-color-white);
  padding: 0.55rem 0.8rem;
  color: var(--sl-color-black);
}

.kern-install-command {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 29rem;
  min-width: 0;
  min-height: 3rem;
  margin-top: 1.25rem;
  border: 1px solid var(--sl-color-hairline-light);
  border-radius: 0.3rem;
  background: var(--sl-color-gray-6);
  padding: 0.32rem 0.38rem 0.32rem 0.8rem;
}

.kern-install-command > div {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 0.65rem;
  color: var(--kern-color-text-muted);
  font-family: var(--__sl-font-mono);
  font-size: 0.8125rem;
}

.kern-install-command code {
  overflow: hidden;
  padding: 0;
  background: transparent;
  color: var(--kern-color-text-strong);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kern-install-command button {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  min-height: 2.15rem;
  border: 0;
  border-left: 1px solid var(--sl-color-hairline-light);
  background: transparent;
  padding: 0 0.55rem 0 0.7rem;
  color: var(--kern-color-text-muted);
  font: inherit;
  font-size: 0.8125rem;
  cursor: pointer;
}

.kern-install-command button:hover {
  color: var(--kern-color-text-strong);
}

.kern-home-examples {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  margin-top: clamp(3.5rem, 7vw, 6rem);
}

.kern-home-example {
  min-width: 0;
  border: 1px solid var(--sl-color-hairline-light);
  background: var(--sl-color-bg);
}

.kern-home-example header {
  display: flex;
  min-height: 3rem;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  border-bottom: 1px solid var(--sl-color-hairline);
  background: var(--sl-color-gray-6);
  padding: 0.65rem 0.85rem;
}

.kern-home-example h2 {
  margin: 0;
  color: var(--kern-color-text-strong);
  font-size: 0.82rem;
  font-weight: 650;
}

.kern-home-example a {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  color: var(--kern-color-interactive);
  font-size: 0.75rem;
  font-weight: 620;
  text-decoration: none;
}

.kern-home-example pre {
  overflow: auto;
  min-height: 9.5rem;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  padding: 1.15rem;
  color: var(--kern-color-text-strong);
  font-size: clamp(0.75rem, 0.9vw, 0.84rem);
  line-height: 1.7;
}

.kern-home-example code {
  padding: 0;
  background: transparent;
  color: inherit;
}

@media (max-width: 62rem) {
  .kern-home-examples {
    grid-template-columns: 1fr;
  }

  .kern-home-example pre {
    min-height: 0;
  }
}

@media (max-width: 32rem) {
  .kern-home {
    padding-top: 3rem;
  }

  .kern-primary-links {
    align-items: flex-start;
    flex-direction: column;
  }
}
</style>
