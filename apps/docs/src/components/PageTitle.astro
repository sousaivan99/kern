---
const { data } = Astro.locals.starlightRoute.entry
---

<header class="kern-page-heading">
  <h1 id="_top">{data.title}</h1>
  {data.description && <p>{data.description}</p>}
</header>

<style>
.kern-page-heading h1 {
  max-width: 19ch;
  margin: 0;
  color: var(--kern-color-text-strong);
  font-size: var(--sl-text-h1);
  font-weight: 720;
  letter-spacing: -0.045em;
  line-height: 1.08;
  text-wrap: balance;
}

.kern-page-heading p {
  max-width: 43rem;
  margin: 1rem 0 0;
  color: var(--kern-color-text-body);
  font-size: clamp(1rem, 1.5vw, 1.08rem);
  line-height: 1.7;
  text-wrap: pretty;
}
</style>
