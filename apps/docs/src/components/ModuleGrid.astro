---
import {
  ArrowRight,
  ArrowUpRight,
  Braces,
  CalendarDays,
  CircleDollarSign,
  Hash,
  List,
  ShieldCheck,
  TimerReset,
  Type,
} from "lucide-astro"

const modules = [
  {
    name: "Validation",
    slug: "validation",
    icon: ShieldCheck,
    detail: "Parse unknown input with fluent, inferred schemas and structured issues.",
    helpers: ["object", "string", "safeParse"],
  },
  {
    name: "Money",
    slug: "money",
    icon: CircleDollarSign,
    detail: "Work in exact minor units with explicit rounding and locale-aware output.",
    helpers: ["formatMoney", "parseMoney", "allocateMoney"],
  },
  {
    name: "Date",
    slug: "date",
    icon: CalendarDays,
    detail: "Keep calendar arithmetic, instant comparison, and formatting explicit.",
    helpers: ["addDays", "startOfDay", "formatDate"],
  },
  {
    name: "Number",
    slug: "number",
    icon: Hash,
    detail: "Use focused numeric calculations and native Intl formatting helpers.",
    helpers: ["clamp", "round", "formatNumber"],
  },
  {
    name: "String",
    slug: "string",
    icon: Type,
    detail: "Handle common text transformations without a general-purpose utility layer.",
    helpers: ["slugify", "truncate", "isBlank"],
  },
  {
    name: "Array",
    slug: "array",
    icon: List,
    detail: "Express common collection operations while preserving immutable inputs.",
    helpers: ["chunk", "uniqueBy", "groupBy"],
  },
  {
    name: "Object",
    slug: "object",
    icon: Braces,
    detail: "Select, inspect, and freeze objects with safe property semantics.",
    helpers: ["pick", "hasOwnPath", "deepFreeze"],
  },
  {
    name: "Async",
    slug: "async",
    icon: TimerReset,
    detail: "Control retries, timing, and concurrency with cancellation support.",
    helpers: ["retry", "sleep", "debounce"],
  },
]
---

<section aria-labelledby="modules-heading" class="kern-modules not-content">
  <header class="kern-modules-heading">
    <div>
      <p>Module guides</p>
      <h2 id="modules-heading">Public entrypoints</h2>
      <span>Import only the module required by your application.</span>
    </div>
    <a href="/modules/">
      Every helper explained
      <ArrowRight aria-hidden="true" size={14} />
    </a>
  </header>

  <div class="kern-module-list">
    {modules.map(({ icon: Icon, ...module }) => (
      <a href={`/modules/${module.slug}/`}>
        <span class="kern-module-icon"><Icon aria-hidden="true" size={17} /></span>
        <div class="kern-module-copy">
          <h3>{module.name}</h3>
          <p>{module.detail}</p>
          <ul aria-label={`Common ${module.name} exports`}>
            {module.helpers.map((helper) => <li><code>{helper}</code></li>)}
          </ul>
          <small>@kern/core/{module.slug}</small>
        </div>
        <ArrowUpRight class="kern-module-arrow" aria-hidden="true" size={15} />
      </a>
    ))}
  </div>
</section>

<style>
.kern-modules {
  padding: clamp(3.75rem, 7vw, 6rem) 0;
}

.kern-modules-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 2.25rem;
}

.kern-modules-heading p {
  margin: 0 0 0.55rem;
  color: var(--kern-color-text-muted);
  font-family: var(--__sl-font-mono);
  font-size: 0.75rem;
  font-weight: 650;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.kern-modules-heading h2 {
  margin: 0;
  color: var(--kern-color-text-strong);
  font-size: clamp(1.65rem, 2.8vw, 2.25rem);
  font-weight: 650;
  letter-spacing: -0.035em;
}

.kern-modules-heading span {
  display: block;
  margin-top: 0.55rem;
  color: var(--kern-color-text-muted);
  font-size: 0.875rem;
}

.kern-modules-heading > a {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 0.35rem;
  color: var(--kern-color-interactive);
  font-size: 0.8125rem;
  font-weight: 620;
  text-decoration: none;
}

.kern-modules-heading > a:hover svg {
  transform: translateX(2px);
}

.kern-module-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.kern-module-list > a {
  display: grid;
  grid-template-columns: 2.1rem minmax(0, 1fr) auto;
  gap: 0.9rem;
  border-top: 1px solid var(--sl-color-hairline);
  padding: 1.35rem 1.5rem 1.35rem 0;
  color: inherit;
  text-decoration: none;
}

.kern-module-list > a:nth-child(even) {
  border-left: 1px solid var(--sl-color-hairline);
  padding-right: 0;
  padding-left: 1.5rem;
}

.kern-module-list > a:nth-last-child(-n + 2) {
  border-bottom: 1px solid var(--sl-color-hairline);
}

.kern-module-icon {
  display: grid;
  width: 2rem;
  height: 2rem;
  place-items: center;
  border: 1px solid var(--sl-color-hairline-light);
  color: var(--kern-color-text-muted);
}

.kern-module-copy h3 {
  margin: 0;
  color: var(--kern-color-text-strong);
  font-size: 0.93rem;
  font-weight: 650;
}

.kern-module-copy > p {
  max-width: 31rem;
  margin: 0.45rem 0 0;
  color: var(--kern-color-text-muted);
  font-size: 0.875rem;
  line-height: 1.55;
}

.kern-module-copy ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  margin: 0.75rem 0 0;
  padding: 0;
  color: var(--kern-color-text-muted);
  list-style: none;
}

.kern-module-copy li + li::before {
  margin: 0 0.45rem;
  color: var(--kern-color-text-muted);
  content: "·";
}

.kern-module-copy code {
  padding: 0;
  background: transparent;
  color: var(--kern-color-text-body);
  font-family: var(--__sl-font-mono);
  font-size: 0.75rem;
}

.kern-module-copy small {
  display: block;
  margin-top: 0.55rem;
  color: var(--kern-color-interactive);
  font-family: var(--__sl-font-mono);
  font-size: 0.75rem;
}

.kern-module-arrow {
  color: var(--kern-color-text-muted);
  transition:
    color 140ms ease,
    transform 140ms ease;
}

.kern-module-list > a:hover h3,
.kern-module-list > a:hover .kern-module-arrow {
  color: var(--kern-color-interactive);
}

.kern-module-list > a:hover .kern-module-arrow {
  transform: translate(2px, -2px);
}

@media (max-width: 44rem) {
  .kern-modules-heading {
    align-items: start;
    flex-direction: column;
    gap: 1rem;
  }

  .kern-module-list {
    grid-template-columns: 1fr;
  }

  .kern-module-list > a,
  .kern-module-list > a:nth-child(even) {
    border-right: 0;
    border-bottom: 0;
    border-left: 0;
    padding: 1.25rem 0;
  }

  .kern-module-list > a:last-child {
    border-bottom: 1px solid var(--sl-color-hairline);
  }
}
</style>
