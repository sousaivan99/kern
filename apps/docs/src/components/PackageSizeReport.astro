---
import report from "../data/package-sizes.json"

const formatBytes = (bytes: number) => `${bytes.toLocaleString("en-US")} B`
const formatKibibytes = (bytes: number) => `${(bytes / 1024).toFixed(2)} KiB`
const repositoryUrl = "https://github.com/sousaivan99/lithekit/blob/develop"
---

<div class="size-report not-content">
  <section aria-labelledby="package-sizes">
    <h2 id="package-sizes">Independently installable packages</h2>
    <p>
      Each row bundles one complete public entrypoint. Framework peers are excluded; Form core is
      included in each adapter measurement. Budgets are release gates.
    </p>
    <section class="size-table-scroll" aria-label="Package size table">
      <table>
        <thead>
          <tr>
            <th scope="col">Install/import</th>
            <th scope="col">Raw</th>
            <th scope="col">gzip</th>
            <th scope="col">Budget</th>
          </tr>
        </thead>
        <tbody>
          {report.packages.map((entry) => (
            <tr>
              <th scope="row"><code>{entry.import}</code></th>
              <td>{formatBytes(entry.rawBytes)}</td>
              <td><strong>{formatKibibytes(entry.gzipBytes)}</strong> ({formatBytes(entry.gzipBytes)})</td>
              <td>{formatKibibytes(entry.budgetBytes)} ({formatBytes(entry.budgetBytes)})</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </section>

  <section aria-labelledby="combined-fixtures">
    <h2 id="combined-fixtures">Realistic combined fixtures</h2>
    <p>These measurements catch integration costs that no single package budget can show.</p>
    <section class="size-table-scroll" aria-label="Combined fixture size table">
      <table>
        <thead>
          <tr>
            <th scope="col">Fixture</th>
            <th scope="col">Raw</th>
            <th scope="col">gzip</th>
            <th scope="col">Budget</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          {report.fixtures.map((fixture) => (
            <tr>
              <th scope="row">{fixture.label}</th>
              <td>{formatBytes(fixture.rawBytes)}</td>
              <td><strong>{formatKibibytes(fixture.gzipBytes)}</strong></td>
              <td>{formatKibibytes(fixture.budgetBytes)}</td>
              <td><a href={`${repositoryUrl}/${fixture.fixture}`}>Source</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </section>

  <section aria-labelledby="measurement-environment">
    <h2 id="measurement-environment">Measurement environment</h2>
    <dl>
      <div>
        <dt>Bun</dt>
        <dd>{report.measurement.bunVersion}</dd>
      </div>
      <div>
        <dt>Target</dt>
        <dd>{report.measurement.target}</dd>
      </div>
      <div>
        <dt>Format</dt>
        <dd>{report.measurement.format}</dd>
      </div>
      <div>
        <dt>Minified</dt>
        <dd>{report.measurement.minified ? "yes" : "no"}</dd>
      </div>
      <div>
        <dt>Compression</dt>
        <dd>{report.measurement.compression}</dd>
      </div>
    </dl>
  </section>
</div>

<style>
.size-report section + section {
  margin-top: 3rem;
}
.size-report h2 {
  padding-bottom: 0.45rem;
  border-bottom: 1px solid var(--sl-color-hairline);
}
.size-table-scroll {
  overflow-x: auto;
  margin-top: 1.25rem;
}
table {
  width: 100%;
  min-width: 42rem;
  border-collapse: collapse;
  font-size: 0.82rem;
}
th,
td {
  border-bottom: 1px solid var(--sl-color-hairline);
  padding: 0.7rem 0.8rem;
  text-align: left;
  white-space: nowrap;
}
thead th {
  background: var(--sl-color-gray-6);
  font-family: var(--__sl-font-mono);
  font-size: 0.72rem;
  text-transform: uppercase;
}
dl {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
  gap: 1rem;
}
dt {
  color: var(--sl-color-gray-3);
  font-size: 0.75rem;
}
dd {
  margin: 0.25rem 0 0;
  font-family: var(--__sl-font-mono);
}
</style>
