{
  "name": "lithekit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling"
  ],
  "scripts": {
    "dev": "bun run docs:dev",
    "docs:dev": "bun --filter @lithekit/docs dev",
    "build": "bun tooling/scripts/build.ts",
    "build:packages": "bun tooling/scripts/packages/build.ts",
    "build:docs": "bun --filter @lithekit/docs build",
    "test": "bun tooling/scripts/test.ts",
    "test:watch": "bun test --watch packages",
    "test:coverage": "bun test --coverage packages",
    "test:fuzz": "LITHEKIT_FUZZ_CASES=${LITHEKIT_FUZZ_CASES:-10000} bun test packages --test-name-pattern=property",
    "test:timezones": "bun tooling/scripts/packages/test-timezones.ts",
    "test:compat": "bun tooling/scripts/packages/compat-check.ts",
    "test:deno": "deno run --allow-read tooling/fixtures/compat/runtime-smoke.mjs packages/validation/dist packages/money/dist packages/date/dist packages/number/dist packages/string/dist packages/array/dist packages/object/dist packages/async/dist",
    "test:browser": "bun tooling/scripts/packages/browser-check.ts",
    "test:frameworks": "bun --filter @lithekit/tooling test:frameworks",
    "typecheck": "bun run --parallel --workspaces --if-present typecheck",
    "typecheck:minimum": "bun tooling/scripts/packages/typecheck-minimum.ts",
    "lint": "bun --filter @lithekit/tooling lint",
    "format": "bun --filter @lithekit/tooling format",
    "format:check": "bun --filter @lithekit/tooling format:check",
    "size": "bun tooling/scripts/packages/size.ts",
    "size:check": "bun tooling/scripts/packages/size.ts --check",
    "size:report": "bun tooling/scripts/packages/size.ts --write-report",
    "benchmark": "bun tooling/benchmarks/index.ts",
    "benchmark:primitives": "bun tooling/benchmarks/index.ts --suite primitives",
    "benchmark:intl:cold": "bun tooling/benchmarks/intl-cold.ts",
    "benchmark:intl:memory": "bun tooling/benchmarks/intl-memory.ts",
    "benchmark:modules": "bun tooling/benchmarks/modules.ts",
    "benchmark:form": "bun tooling/benchmarks/index.ts --suite form",
    "benchmark:form:browser": "bun tooling/benchmarks/form-browser.ts",
    "benchmark:report": "bun tooling/benchmarks/report.ts",
    "benchmark:validation": "bun tooling/benchmarks/index.ts --suite validation-compare",
    "benchmark:validation:lithekit": "bun tooling/benchmarks/index.ts --suite validation-lithekit",
    "benchmark:quick": "bun tooling/benchmarks/index.ts --quick",
    "docs:snippets": "bun --filter @lithekit/docs snippets",
    "docs:a11y": "bun run build:docs && bun --filter @lithekit/docs a11y",
    "docs:check": "bun --filter @lithekit/docs check",
    "package:check": "bun tooling/scripts/packages/package-check.ts",
    "packages:check": "bun tooling/scripts/packages/manifest-check.ts",
    "pack:dry": "bun tooling/scripts/packages/pack-dry.ts",
    "release:check": "bun tooling/scripts/packages/release-contract.ts --json",
    "release:dry": "bun tooling/scripts/packages/release.ts",
    "audit": "bun audit",
    "check": "bun tooling/scripts/check.ts"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "trustedDependencies": [
    "@playwright/browser-chromium"
  ]
}
